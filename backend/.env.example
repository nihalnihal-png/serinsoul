# Copy to .env for local development. Never commit real values.
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NOOP_PUSH_TOKEN=replace-with-a-long-random-secret
# Generate once with: node -e "console.log(crypto.randomUUID())"
# Keep this value stable across deployments and database maintenance.
RECEIVER_STATE_ID=00000000-0000-4000-8000-000000000000
DASHBOARD_API_TOKEN=replace-with-a-separate-long-random-secret